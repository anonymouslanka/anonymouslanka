{
  "id": "/",
  "name": "Detective Lanka",
  "short_name": "Detective Lanka",
  "description": "Open a case and stay anonymous. A moderated, account-free case-file app for reporting crime in Sri Lanka.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f4efe3",
  "theme_color": "#f8f4ea",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "news",
    "social",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
